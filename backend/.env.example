# ── Core ──────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/portfolio
JWT_SECRET=replace-with-a-long-random-string
FRONTEND_URL=https://rshivam.dev
PORT=5000

# ── Admin bootstrap (used on first boot only) ─────────────────────────
ADMIN_DEFAULT_EMAIL=admin@rshivam.dev
ADMIN_DEFAULT_PASSWORD=change-me-before-first-boot
ADMIN_DEFAULT_PIN=0000

# ── Payments (Razorpay) ───────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# ── Transactional email (Resend) ──────────────────────────────────────
# RESEND_API_KEY is the main key: every email route uses it, and all mail is
# sent from noreply@rshivam.dev. The key must belong to the Resend account with
# rshivam.dev verified under Domains.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
APP_BASE_URL=https://rshivam.dev
EMAIL_FROM=noreply@rshivam.dev
EMAIL_SUPPORT=contact@rshivam.dev

# Optional per-surface overrides. Leave blank to reuse RESEND_API_KEY.
RESEND_API_KEY_ADMIN=
RESEND_API_KEY_TEAM=
# Optional sender override; defaults to EMAIL_FROM, then noreply@rshivam.dev.
RESEND_SENDER_EMAIL=

# Recipients for admin alerts
SUPER_ADMIN_EMAIL=contact@rshivam.dev
TEAM_EMAIL_USER=team@rshivam.dev
